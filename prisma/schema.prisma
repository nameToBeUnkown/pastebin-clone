generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
}

model User {
    id             String    @id @default(cuid())
    email          String    @unique
    name           String
    image          String?
    bio            String?
    hashedPassword String?
    createdAt      DateTime  @default(now())
    pastes         Paste[]
    comments       Comment[]
}

model Paste {
    id           String    @id
    title        String
    content      String
    language     String
    isPublic     Boolean   @default(true)
    views        Int       @default(0)
    viewLimit    Int?
    passwordHash String?
    isEncrypted  Boolean   @default(false)
    expiresAt    DateTime?
    createdAt    DateTime  @default(now())
    authorId     String?
    author       User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
    comments     Comment[]

    @@index([authorId])
    @@index([createdAt])
    @@index([isPublic, createdAt])
}

model Comment {
    id        String   @id @default(cuid())
    content   String
    createdAt DateTime @default(now())
    pasteId   String
    paste     Paste    @relation(fields: [pasteId], references: [id], onDelete: Cascade)
    authorId  String
    author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

    @@index([pasteId])
    @@index([authorId])
}
